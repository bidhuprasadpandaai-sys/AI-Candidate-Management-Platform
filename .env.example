# Shared environment for the whole monorepo. Copy to .env (git-ignored) and fill in only what you use.
#
# SECURITY: this file is read by the API (all variables) and by the Vite web app (ONLY variables that
# start with VITE_). Never prefix a secret or AI key with VITE_, or it will be bundled into the browser.
# The web app reaches AI providers through the API, never directly.
# Precedence: apps/api/.env (if present) overrides this file for the API.

# ── App ─────────────────────────────────────────────────────────────────────
PORT=4310
CLIENT_URL=http://localhost:4410
MONGODB_URI=mongodb://127.0.0.1:27017/ai-candidate-management
# Required, 32+ random chars, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# JWT_EXPIRES_SECONDS=28800
# Browser-safe: the only kind of variable the web app may read
VITE_API_BASE_URL=http://localhost:4310/api

# ── AI providers (server-side only; fill in only the providers you want to use) ─
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Server-side refusal fallback for Claude models that support it. Set to "off" to disable.
ANTHROPIC_FALLBACKS=default

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Ollama: the server root (not /v1) and a chat model (not an embedding model).
# With a remote host, resume text is sent to that server.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Bearer token, if a proxy in front of Ollama asks for one
OLLAMA_API_KEY=

# Ollama Cloud (https://ollama.com): the ollama_cloud extractor. Key from ollama.com/settings/keys;
# model = API name from ollama.com/search?c=cloud, without ":cloud". Resume text is redacted first (REDACT_PII).
OLLAMA_CLOUD_API_KEY=
OLLAMA_CLOUD_MODEL=gemma4:31b

# Default extractor when a request or the UI doesn't pick one: rules (default), anthropic, openai, gemini,
# ollama or ollama_cloud. Switching providers is a config change; users can still pick per upload.
LLM_PROVIDER=rules
# Model for LLM_PROVIDER only (overrides its <PROVIDER>_MODEL); empty = that provider's default
LLM_MODEL=

# ── Resume parsing / integration (not yet read by this codebase) ─────────────
# pdfplumber (default, light) or docling (needs requirements-docling.txt)
TEXT_ENGINE=pdfplumber
# Default region for phone numbers written without a country code
DEFAULT_PHONE_REGION=US
# Integration API keys: accountId:apiKey:COMPANYCODES (| separated, * = all), comma-separated for several callers.
COMPAT_KEYS=
# Extractor used for API parses; empty = LLM_PROVIDER
COMPAT_DEFAULT_EXTRACTOR=
# Browser origins allowed to make signed-in changes (comma-separated)
ALLOWED_ORIGINS=http://localhost:4410,http://127.0.0.1:4410
