PORT=4310
CLIENT_URL=http://localhost:4410
MONGODB_URI=mongodb://127.0.0.1:27017/ai-candidate-management
# Required. Use a long random value (32+ chars), e.g. `openssl rand -base64 48`. Never commit the real value.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Optional. Token/cookie lifetime in seconds (default 28800 = 8h, min 300, max 86400).
# JWT_EXPIRES_SECONDS=28800
# In production set NODE_ENV=production and CLIENT_URL to the web app origin (only allowed CORS origin).
