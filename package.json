{
  "name": "ai-candidate-management-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace web dev\" \"yarn workspace api dev\"",
    "dev:web": "yarn workspace web dev",
    "dev:api": "yarn workspace api dev",
    "build": "yarn workspace @acmp/shared build && yarn workspace @acmp/chat build && yarn workspace web build && yarn workspace api build",
    "seed": "yarn workspace api seed",
    "test": "yarn workspace api test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "resolutions": {
    "shell-quote": "^1.12.0"
  },
  "packageManager": "yarn@4.14.1"
}
